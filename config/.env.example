# =============================================================================
# Hermes DevOps Orchestrator — Plantilla de Variables de Entorno (.env.example)
# =============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo a ~/.hermes/.env (o .env local para pruebas en contenedor)
# 2. NUNCA comitees el archivo .env real ni credenciales JSON en Git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Google Cloud Vertex AI (FinOps & Autenticación ADC)
# -----------------------------------------------------------------------------
# Proyecto GCP vinculado a facturación con créditos de Google Developer Program
VERTEX_PROJECT_ID=hermes-devops-agent
GOOGLE_CLOUD_PROJECT=hermes-devops-agent

# Región de inferencia (global habilita endpoints Gemini 3.5 con menor latencia/cuota)
VERTEX_REGION=global
GOOGLE_CLOUD_LOCATION=global

# Ruta a Application Default Credentials (generado vía `gcloud auth application-default login`)
# En contenedor Docker se monta en modo solo-lectura (:ro)
GOOGLE_APPLICATION_CREDENTIALS=/home/ander/.config/gcloud/application_default_credentials.json
VERTEX_CREDENTIALS_PATH=/home/ander/.config/gcloud/application_default_credentials.json

# -----------------------------------------------------------------------------
# 2. Configuración del Orquestador (Hermes Agent)
# -----------------------------------------------------------------------------
HERMES_PROVIDER=vertex
HERMES_DEFAULT_MODEL=google/gemini-3.5-flash
HERMES_AUXILIARY_MODEL=google/gemini-3.5-flash-lite

# -----------------------------------------------------------------------------
# 3. Integraciones y Gateways (Hito 3 — Azure Cloud VM)
# -----------------------------------------------------------------------------
# Token del bot de Telegram obtenido vía @BotFather (dejar vacío en entorno solo-CLI)
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_ALLOWED_USER_IDS=replace_with_numeric_telegram_user_id

# Token para operaciones GitHub CLI / automatización de PRs en subagentes
GITHUB_TOKEN=replace_with_fine_grained_pat

# -----------------------------------------------------------------------------
# 4. Sandbox Docker + OpenCode CLI (Hito 2)
# -----------------------------------------------------------------------------
OPENCODE_SANDBOX_IMAGE=hermes-opencode-sandbox:latest
OPENCODE_WORKSPACE_DIR=/workspace
DOCKER_RUN_UID=1000
DOCKER_RUN_GID=1000
